import { AndroidLogCollector } from './AndroidLogCollector.js';
import { CdpLogCollector } from './CdpLogCollector.js';
import { IosSimulatorLogCollector, } from './IosSimulatorLogCollector.js';
export class CompositeLogCollector {
    collectors;
    name = 'composite-log';
    constructor(collectors) {
        this.collectors = collectors;
    }
    get metadata() {
        return Object.fromEntries(this.collectors.map((collector) => [collector.name, collector.metadata]));
    }
    async collectAsync() {
        const results = [];
        for (const collector of this.collectors) {
            const logs = await collector.collectAsync();
            results.push(`\
## collector: ${collector.name}
### metadata: ${JSON.stringify(collector.metadata)}

${logs}`);
        }
        return results.join('\n--\n');
    }
    async collectRawRecordsAsync() {
        if (this.collectors.length === 0) {
            return [];

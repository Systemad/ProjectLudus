{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "mcp": {
    "dlt": {
      "type": "local",
      "enabled": false,
      "command": [
		"uv",
        "run",
        "--with",
        "dlt-mcp[postgres]",
		"dlt-mcp"
      ],
    },
	"aspire": {
      "type": "local",
      "command": [
        "aspire",
        "agent",
        "mcp"
      ],
      "enabled": false
    },
	"prefect": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "prefect-mcp",
		"prefect-mcp-server"
      ],
      "enabled": false
    },
	"context7": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp@latest"
      ]
    },
    "igdb": {
	  "type": "local",
	  "enabled": false,
	  "command": ["uvx", "igdb-mcp-client"],
      "environment": {
        "CLIENT_ID": "",
        "CLIENT_SECRET": ""
      }
    }
  },
  "share": "disabled"
}
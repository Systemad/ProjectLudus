# Use your computer's LAN address when running on a physical Android device.
EXPO_PUBLIC_API_URL=http://192.168.1.100:5141

# Typesense search uses a client-safe key limited to documents:search on the two
# configured collections. Never use the server administrator key in this app.
EXPO_PUBLIC_TYPESENSE_HOST=neptune.tail78fa0d.ts.net
EXPO_PUBLIC_TYPESENSE_PORT=8108
EXPO_PUBLIC_TYPESENSE_PROTOCOL=http
EXPO_PUBLIC_TYPESENSE_PATH=
EXPO_PUBLIC_TYPESENSE_SEARCH_API_KEY=

# PostHog analytics
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host.example.com
